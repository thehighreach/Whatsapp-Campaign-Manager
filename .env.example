# Meta / WhatsApp Cloud API
# Production: use the System User PERMANENT token (Business Settings > Users > System Users),
# NOT the 24-hour temporary token from API Setup.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_WABA_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
META_APP_SECRET=your_meta_app_secret_here
# Use the latest Graph API version shown in your Meta app dashboard.
GRAPH_API_VERSION=v27.0
# Set to true only after onboarding to the Marketing Messages API for WhatsApp
# (App dashboard > Use cases > WhatsApp > Production setup). Sends via /marketing_messages.
WHATSAPP_USE_MARKETING_MESSAGES_API=false

# Supabase (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Dashboard protection (REQUIRED in production - dashboard is locked without these)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_long_unique_password

# Optional: max recipients allowed per one dashboard send action.
MAX_CAMPAIGN_BATCH=50
